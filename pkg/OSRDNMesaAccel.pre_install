#!/bin/csh -f
# i386 only, for the same reason as the driver: the archive is i386 machine
# code.  The relocatable prefix is the caller's to choose.  (Shape taken from
# openstep-matrox-remade's OSMGAMesaAccel.pre_install; this package has never
# had another name, so the former-name receipt warning there has no
# counterpart here.)

if ($#argv != 2) then
    echo "FAILED (unexpected Installer arguments)"
    exit 1
endif

set cpu = `/usr/bin/arch`
if ("$cpu" != "i386") then
    echo "OSRDNMesaAccel installs only on Intel i386/i486 computers."
    exit 1
endif

exit 0
