#
# RDNR2aProbe load commands.  tools/r2a/pack_probe.py puts a fresh run id in
# the CALL line and writes Load_Commands.sect; tools/r2a/hostcheck.sh checks
# that the result calls radeonR2aEntry with one integer and nothing else, and
# that there is no ADVERTISE (reloading an advertising module hangs
# kern_loader).
#
CALL radeonR2aEntry @RUNID@
WIRE
START
